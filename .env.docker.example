NODE_ENV=production
PORT=3000

# DockerHub image (used by docker-compose.prod.yml)
DOCKER_IMAGE=pubest/wardrobe
DOCKER_CONTAINER_NAME=wardrobe-app

# Google AI (Gemini) — one key per environment
AGENT_PLATFORM_API_KEY_DEV=
AGENT_PLATFORM_API_KEY_UAT=
AGENT_PLATFORM_API_KEY_PROD=

# Supabase — server-side
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Vite build-time (baked into client bundle at build time)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Supabase DB (for migrations)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
