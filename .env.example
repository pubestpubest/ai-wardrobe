# Google AI (Gemini) — one key per environment
AGENT_PLATFORM_API_KEY_DEV=
AGENT_PLATFORM_API_KEY_UAT=
AGENT_PLATFORM_API_KEY_PROD=

# Supabase direct DB connection — dashboard → Settings → Database → URI (Transaction Pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase — create a new project at https://supabase.com/dashboard and paste credentials here
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Admin client — storage uploads, signed URLs, affiliate catalog writes (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=<project-ref>

# OpenWeatherMap — server-side only, powers the Home weather card
OPENWEATHER_API_KEY=

# Comma-separated emails allowed to edit the affiliate catalog from Discover
ADMIN_EMAILS=
